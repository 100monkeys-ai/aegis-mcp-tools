{
  "name": "@100monkeys-ai/zaru-mcp-server",
  "version": "0.16.0-pre-alpha",
  "description": "Zaru MCP Server - Signed Envelope Attestation Layer gateway for Zaru",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node --test --import ./test/register-ts-node.mjs test/*.test.ts",
    "worker:typecheck": "mkdir -p .wrangler/types && wrangler types --include-env=false .wrangler/types/runtime.d.ts && tsc -p tsconfig.worker.json",
    "worker:test": "node --test --test-timeout=30000 --test-force-exit --import ./test/register-ts-node.mjs test/*.worker.test.ts",
    "worker:dry-run": "wrangler deploy --dry-run --env staging --outdir .wrangler/dry-run/staging && wrangler deploy --dry-run --env production --outdir .wrangler/dry-run/production"
  },
  "engines": {
    "node": "^24.11.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [],
  "author": "100monkeys.ai",
  "license": "AGPL-3.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "wrangler": "4.144.0"
  }
}
